{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Point Tracker",
  "version": "2.3.1",
  "identifier": "com.craysball.pointtracker",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "node scripts/vendor.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Point Tracker",
        "width": 1500,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 CRaysball Softworks. All rights reserved.",
    "category": "Productivity",
    "shortDescription": "Track attendance points, reprimands and medical leave",
    "longDescription": "Point Tracker keeps track of attendance points, reprimands and medical leave, shows when points drop off and reprimands expire, and syncs between your computer and phone without an account.",
    "publisher": "CRaysball Softworks"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwNkI3Njg1RkE0RDcyNjAKUldSZ2NrMzZoWFpyOE5IMG9aQ01TdEd4TkFNWWxKcnR4MWtLTlpEWFpibUNweDhsV1EvYm5ZdUUK",
      "endpoints": [
        "https://github.com/TrueCRaysball/point-tracker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
