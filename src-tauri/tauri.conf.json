{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Point Tracker",
  "version": "1.2.0",
  "identifier": "com.craysball.pointtracker",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "node scripts/vendor.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Point Tracker",
        "width": 1500,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 820,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 CRaysball Softworks. All rights reserved.",
    "publisher": "CRaysball Softworks"
  }
}